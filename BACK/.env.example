# --- Required for the real demo ---
# Without it the server runs in MOCK mode (FRONT shows a scripted employee and sample feedback).
OPENAI_API_KEY=

# --- Server ---
PORT=4000
# Comma-separated list of FRONT origins allowed to call this API (CORS).
FRONT_ORIGIN=http://localhost:3000

# --- Optional model overrides ---
REALTIME_MODEL=gpt-realtime
REALTIME_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
COACH_MODEL=gpt-4.1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=marin

# --- Optional abuse guard: max API calls per IP per minute ---
RATE_LIMIT_PER_MIN=30

# --- Simli video avatars (one existing face per employee) ---
# Empty = the call stays a voice call with the portrait placeholder.
SIMLI_API_KEY=
# Optional overrides for which existing face each employee uses.
# SIMLI_FACE_EXPERIENCED=
# SIMLI_FACE_NEW=
# SIMLI_FACE_CHALLENGING=
# SIMLI_FACE_CUSTOM=
# SIMLI_FACE_COACH=
# Optional office backdrop ids (POST /assets/backgrounds). Empty uses the built-in office.
# SIMLI_BG_CALL=
# SIMLI_BG_COACH=
# SIMLI_MAX_SESSION_SECONDS=600
# SIMLI_MAX_IDLE_SECONDS=120
